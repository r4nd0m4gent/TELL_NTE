# Secrets & local credentials — never commit
.env
.env.*
*.crt
*.pem
ca-certificate*

# Python virtual environments (each machine makes its own: see README)
.venv/
venv/

# Python bytecode / caches (in every folder)
__pycache__/
*.py[cod]

# Local data files
data/
# ...except the JSON the funding-network page loads, which must ship with it
!site/network/data/
*.xlsx
*.xls

# Local contribution fallback store
contributions*.json

# OS / editor cruft
.DS_Store
Thumbs.db
