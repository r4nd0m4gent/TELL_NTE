{
 "_about": [
  "The textile keywords of the funding projects. Read by the network page (site/network/index.html),",
  "db/mysql/import_funding.py and db/mysql/build_textile_projects.py: change them here only.",
  "Each keyword is a case-insensitive regular expression (the same syntax in JavaScript and Python),",
  "matched on whole words, with the Dutch terms folded into the English keyword.",
  "Core terms name the textile, clothing, leather or footwear sector itself; related terms",
  "(fibre, fabric, dye, wearable, ...) are common outside it and weigh less.",
  "Phrases matching 'idiom' ('in a timely fashion', 'a wolf in sheep's clothing') are removed before matching.",
  "Which projects count as textile projects is decided by build_textile_projects.py (relevance score)."
 ],
 "idiom": "\\b(?:in|on)\\s+(?:an?|such\\s+an?|this|that|similar|the\\s+same|any)\\s[^.;:]{0,50}?\\bfashion\\b(?!\\s*(?:industry|sector|world|brands?|design|cycle|system|compan|retail|school|student))|\\bin\\s+sheep['’]s\\s+clothing\\b",
 "core": {
  "textile":  "textile|textiel",
  "fashion":  "\\bfashion(?!ed|able|ing)|\\bmode-?(?:industrie|branche|sector|systeem|ontwerp|merk|onderwijs|opleiding|academie|keten|bedrijf|wereld|praktijk|huis|collectie|consument)|\\b(?:duurzame|circulaire|slow) mode\\b",
  "clothing": "\\bcloth(?:ing|es)\\b|(?<!be)kleding|\\bkledij\\b|\\b(?:sports|work|active|under|outer|knit|swim|night|rain|leisure|mens|womens|childrens)wear\\b",
  "garment":  "\\bgarments?\\b",
  "apparel":  "\\bapparel\\b",
  "footwear": "\\bfootwear\\b|\\bshoes?\\b|\\bschoen",
  "leather":  "\\bleather\\b|\\bleder\\b|\\b(?:bio-?based|vegan|plantaardig|kunst)\\s*leer\\b|\\bleerlooi",
  "denim":    "\\bdenim\\b|\\bjeans\\b",
  "yarn":     "\\byarns?\\b|\\bgarens\\b|\\bbreigaren",
  "wool":     "(?<!mineral )(?<!glass )(?<!rock )(?<!stone )(?<!steel )\\bwool(?:len|s)?\\b|\\bwol\\b",
  "cotton":   "\\bcotton\\b|katoen",
  "knitting": "\\bknit(?:s|ted|ting|wear)?\\b|\\bbrei(?:en|garen|werk|machine)",
  "nonwoven": "\\bnon-?wovens?\\b"
 },
 "related": {
  "fibre":     "\\bfib(?:re|er)s?\\b|vezel",
  "fabric":    "\\bfabrics?\\b",
  "weaving":   "\\bweav(?:e|es|ing)\\b|\\bwoven\\b|\\bweven\\b|\\bweverij",
  "polyester": "\\bpolyester\\b",
  "dye":       "\\bdyes?\\b|\\bdyeing\\b|\\bververij",
  "silk":      "\\bsilk\\b",
  "hemp":      "\\bhemp\\b|hennep",
  "flax":      "\\bflax\\b|\\blinen\\b|\\bvlas\\b|\\blinnen\\b",
  "wearable":  "\\bwearables?\\b",
  "thread":    "\\bthreads?\\b",
  "cloth":     "\\bcloth\\b",
  "sewing":    "\\bsewing\\b|\\bnaai(?:en|atelier|machine)",
  "upcycling": "\\bupcycl"
 }
}
